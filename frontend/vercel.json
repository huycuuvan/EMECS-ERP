{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://THAY-BANG-DOMAIN-BACKEND/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://THAY-BANG-DOMAIN-BACKEND/uploads/:path*" },
    { "source": "/health", "destination": "https://THAY-BANG-DOMAIN-BACKEND/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
